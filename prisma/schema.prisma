generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  password      String?
  role          String         @default("tecnico")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceOrders ServiceOrder[]
  settings      UserSetting[]
}

model ServiceOrder {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientName        String?
  clientCpf         String?
  clientFantasia    String?
  clientCnpj        String?
  clientEndereco    String?
  clientCidade      String?
  clientCep         String?
  clientTelefone    String?
  clientEmail       String?
  numeroOs          String?
  equipamento       String?
  tecnico           String?
  problemaInformado String?  @db.Text

  selectedServices  String   @db.Text // JSON em texto
  observacoes       String?  @db.Text
  detalhesSistema   String?  @db.Text
  contrato          String?  @db.Text
  pagamento         String?  @db.Text

  dataAtendimento   String?
  horaEntrada       String?
  horaSaida         String?
  responsavel       String?

  signatureData     String?  @db.Text
  archived          Boolean  @default(false)
  status            String   @default("finalizado")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pdf               OrderPdf?

  @@index([userId])
  @@index([createdAt])
}

model OrderPdf {
  orderId   String       @id
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime     @default(now())
}

model UserSetting {
  userId String
  key    String
  value  String @db.Text // JSON em texto
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}
