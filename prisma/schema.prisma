generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/ordem_servico_app/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("tecnico")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  serviceOrders ServiceOrder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ServiceOrder {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Client data extracted from PDF
  clientName        String?
  clientCpf         String?
  clientFantasia    String?
  clientCnpj        String?
  clientEndereco    String?
  clientCidade      String?
  clientCep         String?
  clientTelefone    String?
  clientEmail       String?
  numeroOs          String?
  equipamento       String?
  tecnico           String?
  problemaInformado String?  @db.Text
  
  // Service details
  selectedServices  String   @db.Text  // JSON stringified array
  observacoes       String?  @db.Text
  
  // Attendance details
  dataAtendimento   String?
  horaEntrada       String?
  horaSaida         String?
  responsavel       String?
  
  // File storage
  signatureData     String?  @db.Text  // base64 signature image
  uploadedPdfPath   String?  // cloud_storage_path for uploaded PDF
  uploadedPdfPublic Boolean  @default(false)
  generatedPdfPath  String?  // cloud_storage_path for generated PDF
  generatedPdfPublic Boolean @default(false)
  
  status            String   @default("rascunho")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}
