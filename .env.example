# ============================================================
# AUTOCOM - Ordem de Servico (Next.js + Supabase)
# Arquivo de EXEMPLO - NAO coloque credenciais reais aqui.
# ============================================================
#
# Em producao, defina estas duas variaveis na Vercel:
#   Settings > Environment Variables (marque Production, Preview e Development)
# Para rodar localmente, copie este arquivo para .env.local e preencha.
#
# Onde achar: Supabase > Project Settings > API
#   - Project URL         -> NEXT_PUBLIC_SUPABASE_URL
#   - anon / public key   -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# A chave "anon" e publica por desenho; quem protege os dados e o login e
# as politicas RLS de supabase/schema.sql. NUNCA use a chave "service_role".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional/legado) usado apenas pelo script scripts/export-data.ts.
# DATABASE_URL=
