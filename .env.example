# Supabase (Connect > ORMs/Prisma). Troque [SENHA] pela senha do banco (caracteres especiais em formato URL).
# DATABASE_URL = Transaction pooler (porta 6543)
DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = Session pooler (porta 5432), usado só pelo prisma db push
DIRECT_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

NEXTAUTH_SECRET="gere-um-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Código que quem for criar conta precisa digitar (evita que qualquer pessoa se cadastre)
CONVITE_CODIGO="escolha-um-codigo"
